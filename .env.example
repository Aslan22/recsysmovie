# Образец файла .env. Скопируйте его в .env и подставьте свои значения.
# Сам .env в git не попадает (он в .gitignore), потому что в нём пароль от базы.

# Строка подключения к Postgres: postgresql://пользователь:пароль@хост:порт/имя_базы
RECSYS_DB_URL=postgresql://user:password@localhost:5432/recsys

# Полный путь к файлу movie.csv из датасета MovieLens 20M
MOVIE_PATH=C:/path/to/archive/movie.csv

# Необязательно: папка с датасетом (rating_cut.csv, rating_upd/).
# Если не задать, берётся папка, в которой лежит movie.csv.
# DATA_DIR=C:/path/to/archive
